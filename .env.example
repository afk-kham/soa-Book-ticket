# Mỗi service có .env.example RIÊNG trong services/<tên>/ — sao chép thành .env ở đó.
# File này chỉ liệt kê tên biến chung để cả nhóm dùng thống nhất.
# PORT, DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASSWORD   (Payment: HOST, PORT, MONGO_URI, MONGO_DB)
# Booking thêm: USER_SERVICE_URL, MOVIE_SERVICE_URL, SHOWTIME_SERVICE_URL, PAYMENT_SERVICE_URL, NOTIFICATION_SERVICE_URL
# Showtime thêm: MOVIE_SERVICE_URL, VALIDATE_MOVIE
