# Sao chép thành .env khi chạy local (KHÔNG commit .env)
HOST=0.0.0.0
PORT=5006
DB_PATH=./data/notification.db

# Khóa JWT HS256 (cuối kỳ): CẢ NHÓM DÙNG CHUNG một khóa, >= 32 ký tự, UTF-8 thô. KHÔNG commit khóa thật.
JWT_SECRET=
# Khóa nội bộ Booking -> Notification (header X-Internal-Key). KHÔNG commit khóa thật.
INTERNAL_KEY=
