# Sao chép thành .env khi chạy local (KHÔNG commit .env)
HOST=0.0.0.0
PORT=5005
DB_PATH=./data/payment.db

# Khóa JWT HS256 (cuối kỳ): CẢ NHÓM DÙNG CHUNG một khóa, >= 32 ký tự, UTF-8 thô. KHÔNG commit khóa thật.
JWT_SECRET=

# VNPAY Sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg). KHÔNG commit khóa thật.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5005/api/payment/vnpay/return
CLIENT_URL=http://localhost:8080
