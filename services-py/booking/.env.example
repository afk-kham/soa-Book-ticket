# Sao chép thành .env khi chạy local (KHÔNG commit .env)
HOST=0.0.0.0
PORT=5004
DB_PATH=./data/booking.db

# Trong Docker Compose dùng tên service: http://user:5003
USER_SERVICE_URL=http://localhost:5003
# Trong Docker Compose dùng tên service: http://movie:5001
MOVIE_SERVICE_URL=http://localhost:5001
# Trong Docker Compose dùng tên service: http://showtime:5002
SHOWTIME_SERVICE_URL=http://localhost:5002
# Trong Docker Compose dùng tên service: http://payment:5005
PAYMENT_SERVICE_URL=http://localhost:5005
# Trong Docker Compose dùng tên service: http://notification:5006
NOTIFICATION_SERVICE_URL=http://localhost:5006
UPSTREAM_TIMEOUT_SECONDS=5
HOLD_MINUTES=10
# Cùng múi giờ với Showtime (giờ chiếu, hạn giữ ghế). Không đổi nếu không đổi cả Showtime.
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Khóa JWT HS256 (cuối kỳ): CẢ NHÓM DÙNG CHUNG một khóa, >= 32 ký tự, UTF-8 thô. KHÔNG commit khóa thật.
JWT_SECRET=
# Công tắc xác thực cuối kỳ (D-18). Chỉ bật khi User đã cấp JWT thật và Client/Admin đã gửi token.
JWT_REQUIRED=false
# Khóa nội bộ Booking -> Notification (header X-Internal-Key). KHÔNG commit khóa thật.
INTERNAL_KEY=
