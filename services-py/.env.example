# Biến cho docker-compose (tùy chọn). Sao chép thành .env để dùng. KHÔNG commit file .env thật.

# ================= 1. CỔNG PUBLISH RA MÁY HOST =================
# Đổi cổng nếu máy bị trùng (cổng nội bộ trong container giữ nguyên).
MOVIE_HOST_PORT=5001
SHOWTIME_HOST_PORT=5002
USER_HOST_PORT=5003
BOOKING_HOST_PORT=5004
PAYMENT_HOST_PORT=5005
NOTIFICATION_HOST_PORT=5006
GATEWAY_HOST_PORT=8000
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
CLIENT_HOST_PORT=8080
ADMIN_HOST_PORT=8081

# ================= 2. NGHIỆP VỤ & TIMEOUT =================
HOLD_MINUTES=10
UPSTREAM_TIMEOUT_SECONDS=5
VALIDATE_MOVIE=true
AUTO_SCHEDULE_DAYS=7
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ================= 3. BẢO MẬT (JWT & NỘI BỘ) =================
# Khóa dùng chung cả nhóm (>= 32 ký tự). Để trống -> User phát demo-token-. KHÔNG commit khóa thật.
JWT_SECRET=1tRVkL7fuQm1iG_S12IyjFF8gdxyR9Q3rdE0jHLBIBs
# true = Booking ép kiểm tra Bearer JWT (khi đó bắt buộc điền JWT_SECRET >= 32 ký tự).
# Lưu ý: giữ false nếu đang dùng trang Admin (Admin chưa có đăng nhập JWT).
JWT_REQUIRED=false
# Khóa bí mật nội bộ (tùy chọn) Booking gửi qua X-Internal-Key tới Notification.
INTERNAL_KEY=sHwCC8VSd1D2JeCRZn1WVsb68OJH7C9O

# ================= 4. OTP THANH TOÁN =================
OTP_REQUIRED=true
# true = trả thêm devOtp trong JSON khi demo/test; đặt false khi chạy thật.
OTP_DEBUG=true
OTP_RESEND_SECONDS=10

# ================= 5. VNPAY SANDBOX =================
# Tự điền mã từ cổng VNPAY Sandbox nếu test thanh toán VNPAY. KHÔNG commit khóa thật.
VNPAY_TMN_CODE=DA5U1AQ5
VNPAY_HASH_SECRET=ZBKGSPQYQVENZUUBQCXCMCGVFMYVFKYV
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5005/api/payment/vnpay/return
CLIENT_URL=http://localhost:8080

# ================= 6. EMAIL SMTP THẬT (NOTIFICATION) =================
# Để trống SMTP_HOST -> chạy chế độ giả lập (SIMULATED). Điền thông tin SMTP (vd Gmail App Password) để gửi email thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
