# Biến cho docker-compose (tùy chọn). KHÔNG commit file .env thật.
# Đổi cổng publish ra máy host nếu bị trùng (cổng trong container giữ nguyên).
MOVIE_HOST_PORT=5001
SHOWTIME_HOST_PORT=5002
USER_HOST_PORT=5003
BOOKING_HOST_PORT=5004
PAYMENT_HOST_PORT=5005
NOTIFICATION_HOST_PORT=5006

HOLD_MINUTES=10
UPSTREAM_TIMEOUT_SECONDS=5
VALIDATE_MOVIE=true
AUTO_SCHEDULE_DAYS=7
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Khóa dùng chung cả nhóm (>= 32 ký tự). Để trống ở khung; điền ở máy mình. KHÔNG commit khóa thật.
JWT_SECRET=
INTERNAL_KEY=
