# Sao chép thành .env khi chạy local (KHÔNG commit .env)
HOST=0.0.0.0
PORT=5002
DB_PATH=./data/showtime.db

# Trong Docker Compose dùng tên service: http://movie:5001
MOVIE_SERVICE_URL=http://localhost:5001
VALIDATE_MOVIE=true
AUTO_SCHEDULE_DAYS=7
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Khóa JWT HS256 (cuối kỳ): CẢ NHÓM DÙNG CHUNG một khóa, >= 32 ký tự, UTF-8 thô. KHÔNG commit khóa thật.
JWT_SECRET=
