# Sao chép thành .env (KHÔNG commit .env)
PORT=5004
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booking_db
DB_USER=root
DB_PASSWORD=
# Booking gọi các service khác QUA HTTP (không bao giờ đọc DB của họ)
USER_SERVICE_URL=http://localhost:5003
MOVIE_SERVICE_URL=http://localhost:5001
SHOWTIME_SERVICE_URL=http://localhost:5002
PAYMENT_SERVICE_URL=http://localhost:5005
NOTIFICATION_SERVICE_URL=http://localhost:5006
UPSTREAM_TIMEOUT_SECONDS=5
# Thời gian giữ ghế (phút) cho đơn chờ thanh toán; hết hạn thì đơn tự hủy và nhả ghế
HOLD_MINUTES=10
# Windows không cần quyền Administrator với http://localhost:5004/ (mặc định). Muốn máy khác gọi được: BOOKING_PREFIX=http://+:5004/ (chạy bằng Administrator)
# BOOKING_PREFIX=http://localhost:5004/
# CHỈ dùng khi test không có DB: BOOKING_STORE=memory
BOOKING_STORE=mysql
