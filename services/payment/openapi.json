{
  "openapi": "3.0.3",
  "info": {
    "title": "Payment Service API",
    "version": "1.0.0",
    "description": "REST API ghi nhận và tra cứu giao dịch thanh toán giả lập. Chưa kết nối cổng thanh toán thật."
  },
  "servers": [
    {
      "url": "/",
      "description": "Payment Service hiện tại"
    }
  ],
  "tags": [
    {
      "name": "Payment",
      "description": "Giao dịch thanh toán"
    },
    {
      "name": "Health",
      "description": "Trạng thái dịch vụ"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Kiểm tra Payment Service",
        "operationId": "getPaymentHealth",
        "responses": {
          "200": {
            "description": "Service đang hoạt động",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthEnvelope" },
                "example": {
                  "status": "success",
                  "data": { "service": "payment-service", "port": 5005 }
                }
              }
            }
          }
        }
      }
    },
    "/api/payment": {
      "get": {
        "tags": ["Payment"],
        "summary": "Tra cứu giao dịch",
        "operationId": "listPayments",
        "parameters": [
          {
            "name": "bookingId",
            "in": "query",
            "required": false,
            "description": "Lọc giao dịch theo mã đơn đặt vé",
            "schema": { "type": "integer", "minimum": 1 },
            "example": 123
          }
        ],
        "responses": {
          "200": {
            "description": "Danh sách giao dịch, mới nhất trước",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentListEnvelope" },
                "example": {
                  "status": "success",
                  "data": [
                    {
                      "id": "65f000000000000000000001",
                      "bookingId": 123,
                      "amount": 120000,
                      "method": "MOMO",
                      "status": "PAID",
                      "paidAt": "2026-10-20T10:00:00.000Z"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "bookingId không hợp lệ",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "500": {
            "description": "Lỗi máy chủ hoặc database",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      },
      "post": {
        "tags": ["Payment"],
        "summary": "Ghi nhận giao dịch thanh toán",
        "operationId": "createPayment",
        "description": "Đây là thanh toán mô phỏng, không gọi ngân hàng/ví thật. Giao dịch hợp lệ được ghi vào MongoDB. Số tiền dương cùng phương thức hỗ trợ tạo trạng thái PAID; số tiền không dương hoặc phương thức không hỗ trợ được ghi nhận là FAILED. Gửi lại một đơn đã PAID sẽ bị từ chối.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PaymentRequest" },
              "examples": {
                "momo": {
                  "summary": "Thanh toán MoMo mô phỏng",
                  "value": { "bookingId": 123, "amount": 120000, "method": "MOMO" }
                },
                "bankTransfer": {
                  "summary": "Thanh toán chuyển khoản mô phỏng",
                  "value": { "bookingId": 124, "amount": 180000, "method": "BANK_TRANSFER" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Giao dịch đã được ghi nhận; trạng thái nghiệp vụ nằm trong data.status",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentEnvelope" },
                "examples": {
                  "paid": {
                    "summary": "Giao dịch thành công",
                    "value": {
                      "status": "success",
                      "data": {
                        "id": "65f000000000000000000001",
                        "bookingId": 123,
                        "amount": 120000,
                        "method": "MOMO",
                        "status": "PAID",
                        "paidAt": "2026-10-20T10:00:00.000Z"
                      }
                    }
                  },
                  "failed": {
                    "summary": "Giao dịch thất bại nhưng đã được ghi nhận",
                    "value": {
                      "status": "success",
                      "data": {
                        "id": "65f000000000000000000002",
                        "bookingId": 124,
                        "amount": 0,
                        "method": "MOMO",
                        "status": "FAILED",
                        "paidAt": "2026-10-20T10:01:00.000Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "JSON hoặc trường dữ liệu không hợp lệ",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
            }
          },
          "409": {
            "description": "Đơn đã có giao dịch PAID",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ErrorEnvelope" },
                "example": { "status": "error", "code": "ALREADY_PAID", "message": "Đơn #123 đã được thanh toán" }
              }
            }
          },
          "413": {
            "description": "Request body vượt quá giới hạn 1 MiB",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          },
          "500": {
            "description": "Lỗi máy chủ hoặc database",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } } }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PaymentRequest": {
        "type": "object",
        "required": ["bookingId", "amount", "method"],
        "properties": {
          "bookingId": { "type": "integer", "minimum": 1, "example": 123 },
          "amount": { "type": "number", "description": "Số tiền dương mới có thể được đánh dấu PAID; giá trị không dương được ghi là FAILED.", "example": 120000 },
          "method": { "type": "string", "description": "Phương thức hỗ trợ: BANK_TRANSFER, MOMO, VNPAY, CASH. Phương thức khác được ghi là FAILED.", "example": "MOMO" }
        }
      },
      "Transaction": {
        "type": "object",
        "required": ["id", "bookingId", "amount", "method", "status", "paidAt"],
        "properties": {
          "id": { "type": "string", "description": "Mã giao dịch do MongoDB tạo" },
          "bookingId": { "type": "integer" },
          "amount": { "type": "number" },
          "method": { "type": "string" },
          "status": { "type": "string", "enum": ["PAID", "FAILED"] },
          "paidAt": { "type": "string", "format": "date-time" }
        }
      },
      "PaymentEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "data": { "$ref": "#/components/schemas/Transaction" }
        }
      },
      "PaymentListEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/Transaction" } }
        }
      },
      "HealthEnvelope": {
        "type": "object",
        "required": ["status", "data"],
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "data": {
            "type": "object",
            "required": ["service", "port"],
            "properties": { "service": { "type": "string" }, "port": { "type": "integer" } }
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["status", "code", "message"],
        "properties": {
          "status": { "type": "string", "enum": ["error"] },
          "code": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
