# Sao chép thành file .env (KHÔNG commit .env). Booking Service và docker compose cùng đọc file này.
PORT=5004
# Mặc định chỉ nhận request trên máy mình (không cần quyền Admin).
# Khi ghép nhóm qua mạng LAN: http://+:5004/ (xem README, cần netsh urlacl 1 lần)
LISTEN_PREFIXES=http://localhost:5004/
# mysql (mặc định) hoặc sqlserver
DB_PROVIDER=mysql
DB_HOST=127.0.0.1
# 3307 = MySQL chạy bằng docker-compose.yml của Booking; dùng XAMPP/MySQL cài sẵn thì đổi thành 3306
DB_PORT=3307
DB_NAME=booking_db
DB_USER=root
DB_PASSWORD=
# Cuối kỳ: khóa JWT dùng chung với User/Payment (giữa kỳ chưa dùng)
JWT_SECRET=day-la-khoa-bi-mat-cho-do-an-soa-2024-phai-du-256bit
